PROJECT_NAME=app-story-workflow
ENVIRONMENT=development
# DEBUG, INFO, WARNING, ERROR. Logs are JSON on stdout (for Promtail/Loki)
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/app_story_workflow

REDIS_URL=redis://127.0.0.1:6379

OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

FRONTEND_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=
COOKIE_SECURE=False
COOKIE_SAMESITE=none # change to 'lax' or 'strict' in production, and make sure to set COOKIE_DOMAIN to your domain for proper cookie handling for cross-origin requests. 
# NB: Both frontend and backend must be served over HTTPS for 'secure' cookies to work.
# COOKIE_SECURE must already be True there (it is, per your prod setup) — browsers reject SameSite=None cookies that aren't also Secure, so this only works because you're already on HTTPS.

MAX_PROFILE_IMAGE_SIZE_MB=5
MAX_ID_DOCUMENT_SIZE_MB=5
MAX_SELFIE_SIZE_MB=15
MAX_POST_IMAGE_SIZE_MB=5
MAX_POST_VIDEO_SIZE_MB=50
MAX_POST_MEDIA_ITEMS=5

GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REGISTRATION_TOKEN_EXPIRE_MINUTES=30

CUSTOMER_TOKEN_SIGNING_KEY=changeme

RESEND_API_KEY=
RESEND_SENDER_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=https://decky-auth-storage-655495220449-us-east-1-an.s3.amazonaws.com

# Match-service sync (optional; leave empty to switch it off)
MATCH_SERVICE_URL=
MATCH_INTERNAL_API_KEY=
